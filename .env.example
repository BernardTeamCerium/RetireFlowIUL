# Copy these into Netlify → Site configuration → Environment variables
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="RetireFlow <hello@getretireflow.com>"
EMAIL_REPLY_TO=hello@getretireflow.com
LEADS_NOTIFY_EMAIL=you@getretireflow.com
# Optional: defaults to Netlify's site URL
SITE_URL=https://iul.getretireflow.com

# Google Sheet lead log (see google-sheets/Code.gs)
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/XXXXXXXX/exec
GOOGLE_SHEETS_SECRET=the-same-long-random-string-as-in-Code.gs

# Meta Conversions API (server-side conversion tracking)
META_PIXEL_ID=123456789012345
META_CAPI_TOKEN=EAAB...
# Only while testing in Events Manager → Test events; remove afterwards
META_TEST_EVENT_CODE=
